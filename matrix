#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/vendor/autoload.php';

use Matrix\Application;
use Matrix\Console\Console;

$app = new Application(['debug' => false]);
$console = new Console($app);

// serve
$console->register('serve', function (array $args) {
    $host = $args[0] ?? '0.0.0.0';
    $port = $args[1] ?? '8000';
    $docroot = $args[2] ?? 'public';

    printf("Matrix dev server: http://%s:%s\n", $host, $port);
    passthru(sprintf('php -S %s:%s -t %s %s/router.php', escapeshellarg($host), escapeshellarg($port), escapeshellarg($docroot), escapeshellarg($docroot)));
    return 0;
}, 'Start dev server [host] [port] [docroot]');

// migrate
$console->register('migrate', function (array $args) {
    $phinx = __DIR__ . '/vendor/bin/phinx';
    $config = __DIR__ . '/config/phinx.php';
    passthru(sprintf('%s migrate -c %s', escapeshellcmd($phinx), escapeshellarg($config)));
    return 0;
}, 'Run database migrations');

// make:migration
$console->register('make:migration', function (array $args) {
    $name = $args[0] ?? null;
    if (!$name) {
        echo "Usage: ./matrix make:migration <Name>\n";
        return 1;
    }
    $phinx = __DIR__ . '/vendor/bin/phinx';
    $config = __DIR__ . '/config/phinx.php';
    passthru(sprintf('%s create %s -c %s', escapeshellcmd($phinx), escapeshellarg($name), escapeshellarg($config)));
    return 0;
}, 'Create migration make:migration <Name>');

// make:controller
$console->register('make:controller', function (array $args) {
    $name = $args[0] ?? null;
    if (!$name) {
        echo "Usage: ./matrix make:controller <Name>\n";
        return 1;
    }

    $dir = __DIR__ . '/app/Controllers';
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }

    $file = $dir . '/' . $name . '.php';
    if (file_exists($file)) {
        echo "Controller already exists: {$file}\n";
        return 1;
    }

    $stub = <<<PHP
<?php

declare(strict_types=1);

namespace App\Controllers;

use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;

class {$name}
{
    public function index(Request \$request): Response
    {
        return new JsonResponse(['message' => 'Hello from {$name}!']);
    }
}
PHP;

    file_put_contents($file, $stub);
    echo "Controller created: app/Controllers/{$name}.php\n";
    return 0;
}, 'Create controller make:controller <Name>');

// make:middleware
$console->register('make:middleware', function (array $args) {
    $name = $args[0] ?? null;
    if (!$name) {
        echo "Usage: ./matrix make:middleware <Name>\n";
        return 1;
    }

    $dir = __DIR__ . '/app/Middlewares';
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }

    $file = $dir . '/' . $name . '.php';
    if (file_exists($file)) {
        echo "Middleware already exists: {$file}\n";
        return 1;
    }

    $stub = <<<PHP
<?php

declare(strict_types=1);

namespace App\Middlewares;

use Closure;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;

class {$name}
{
    public function __invoke(Request \$request, Closure \$next): Response
    {
        // before

        /** @var Response \$response */
        \$response = \$next(\$request);

        // after

        return \$response;
    }
}
PHP;

    file_put_contents($file, $stub);
    echo "Middleware created: app/Middlewares/{$name}.php\n";
    return 0;
}, 'Create middleware make:middleware <Name>');

exit($console->run($argv));
