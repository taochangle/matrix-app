{
    "name": "taochangle/matrix-app",
    "type": "project",
    "description": "Matrix application scaffold",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "taochangle/matrix-framework": "*@dev",
        "maximebf/debugbar": "^1.18"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/taochangle/matrix-framework.git"
        }
    ],
    "config": {
        "audit": {
            "ignore": ["PKSA-y2cr-5h3j-g3ys"]
        },
        "github-protocols": ["https"]
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    }
}
